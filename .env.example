# Base de Datos
# Local: DB_HOST=localhost, DB_PORT=5432
# Docker: DB_HOST se configura como "db" en docker-compose
DB_HOST=localhost
DB_PORT=5432
DB_NAME=geo_servicios_db
DB_USER=postgres
DB_PASSWORD=tu_contraseña_aqui

# Servidor
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=cambia_este_secret_por_uno_seguro_min_32_chars
JWT_EXPIRES_IN=24h

# CORS (separar multiples origenes con coma)
ALLOWED_ORIGINS=http://localhost:3000
